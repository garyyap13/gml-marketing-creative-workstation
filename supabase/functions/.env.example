# Edge Function secrets for the local stack. Copy to supabase/functions/.env (gitignored), which `supabase start`
# loads; on the hosted project, `supabase secrets set --env-file supabase/functions/.env`. Never commit real values.

# Google Drive, read-only (TRD T-19, D-69). The drive-worker function reads Version file metadata as this service
# account, which has Viewer access to the Version files folder.
# The service account's JSON key, in base64 on one line. Write it with:
#   node scripts/save-drive-key.ts ~/Downloads/<downloaded key>.json
DRIVE_SERVICE_ACCOUNT_KEY=base64-of-the-service-account-json-key
# The Version files folder's ID: the last part of its link, https://drive.google.com/drive/folders/<ID>.
DRIVE_VERSION_FOLDER_ID=your-version-files-folder-id

# Telegram notifications (D-82, TRD T-16). The telegram-worker function sends each notification as a private message
# from the workstation's bot.
# The bot's token from Telegram's @BotFather. Write it with (it reads the token without showing it):
#   node scripts/save-telegram-token.ts
TELEGRAM_BOT_TOKEN=123456789:token-from-botfather
# The web app's address, for the link in each message to the task in My Tasks. Locally the Vite dev server.
APP_BASE_URL=http://127.0.0.1:5173
# Hosted project only: the secret_token given to setWebhook (1-256 of A-Z, a-z, 0-9, _ and -), which Telegram sends
# with every update. While it is unset, each run polls getUpdates instead, as on the local stack.
# TELEGRAM_WEBHOOK_SECRET=
